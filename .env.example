# Kindred — example environment configuration.
#
# Copy these names into your host's secret store (for example, Hugging Face
# Space secrets) or your local shell environment. Keys belong in the host's
# secret store, never in this repository — do not commit real values.

# Qloo Taste API key. Leave empty to run on built-in fixture data.
QLOO_API_KEY=

# Qloo API base URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Transport selection: "auto" uses live Qloo when a key is configured and
# fixture data otherwise. Set to "fixture" to force demo data, or "live"
# to require the live API.
QLOO_TRANSPORT=auto

# Optional. Used only for conversational narration; picks are always
# computed from Qloo data, never from the language model.
GOOGLE_API_KEY=

# Language model used for narration when GOOGLE_API_KEY is set.
KINDRED_LLM_MODEL=gemini-2.5-flash

# Server-side response cache directory (private, not committed).
KINDRED_CACHE_DIR=data/cache

# Port the server listens on.
PORT=7860
